{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "roslyngate": {
        "type": "local",
        "command": [
          "dotnet",
          "src/RoslynGate.Cli/bin/Debug/net10.0/RoslynGate.Cli.dll"
        ],
        "cwd": ".",
        // Expose the four tools directly instead of through Code Mode.
        "codemode": false
      }
    }
  }
}
