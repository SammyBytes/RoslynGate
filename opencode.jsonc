{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    // Show the agent task list in OpenCode.
    "todo": true
  },
  "mcp": {
    "servers": {
      "roslyngate": {
        "type": "local",
        "command": [
          "dotnet",
          "src/RoslynGate.Cli/bin/Debug/net10.0/roslyngate.dll"
        ],
        "cwd": ".",
        // Expose the tools directly instead of through Code Mode.
        "codemode": false
      }
    }
  }
}
