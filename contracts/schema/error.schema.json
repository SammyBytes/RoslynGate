{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tool-error",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "hint": { "type": "string" },
        "try": { "type": "object" }
      },
      "required": ["code", "message", "hint"]
    }
  },
  "required": ["error"]
}
